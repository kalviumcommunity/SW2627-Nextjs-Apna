generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  VIEWED
  APPROVED
  REJECTED
}

model Application {
  id            String            @id @default(cuid())
  candidateName String
  jobTitle      String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}